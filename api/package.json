{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/api/src/server.js",
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/api/src/server.js",
    "start:source": "tsx src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed:structure": "tsx prisma/seed.ts",
    "seed:content": "tsx prisma/seedSublessons.ts",
    "seed:all": "tsx prisma/seedAll.ts",
    "seed:golden": "tsx prisma/seedGolden.ts",
    "seed:scenes": "tsx prisma/seedScenes.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "db:patch": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260829180000_phase31_learner_extensions/migration.sql",
    "db:status": "prisma migrate status",
    "validate:content": "tsx prisma/content/validate-cli.ts",
    "validate:curriculum": "tsx prisma/content/validate-curriculum-cli.ts",
    "validate:portfolio": "tsx prisma/content/validate-portfolio-cli.ts",
    "validate": "npm run typecheck && npm test && npm run validate:content && npm run validate:curriculum && npm run validate:portfolio",
    "retention": "node dist/api/src/ops/retention.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@clerk/express": "^2.1.51",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "music-metadata": "^11.15.0",
    "stripe": "^22.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.9",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
