generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Motivation {
  TRAVEL
  HERITAGE
  CAREER
  FUN
}

enum DeliveryMode {
  STORY
  DRILL
  IMMERSION
  PROFESSIONAL
}

model User {
  id                  String       @id @default(uuid())
  clerkId             String       @unique
  email               String       @unique
  motivation          Motivation?
  preferredMode       DeliveryMode @default(DRILL)
  dailyGoalXp         Int          @default(50)
  xpTotal             Int          @default(0)
  unlockedCosmetics   String[]     @default(["gold"])
  equippedCosmetic    String       @default("gold")
  streakDays          Int          @default(0)
  lastActiveAt        DateTime?
  isPro               Boolean      @default(false)
  onboardingCompleted Boolean      @default(false)
  currentLevel        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  progress       UserProgress[]
  streakLogs     StreakLog[]
  conceptMastery ConceptMastery[]
  vocabProgress  UserVocabProgress[]
}

model Course {
  id           String  @id @default(uuid())
  languageCode String
  cefrLevel    String
  title        String
  isPublished  Boolean @default(false)
  language     String @default("es")  
  ttsLang      String @default("es-ES")

  units      Unit[]
  vocabulary Vocabulary[]
}

model Unit {
  id         String @id @default(uuid())
  courseId   String
  title      String
  orderIndex Int

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concepts Concept[]
}

model Concept {
  id          String @id @default(uuid())
  unitId      String
  name        String
  cefrLevel   String
  grammarNote String
  vocabItems  Json
  orderIndex  Int
  xpReward    Int    @default(20)

  unit     Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  variants LessonVariant[]
  progress UserProgress[]
  mastery  ConceptMastery[]
  subLessons SubLesson[]
}

model LessonVariant {
  id           String       @id @default(uuid())
  conceptId    String
  mode         DeliveryMode
  storyBeat    String?
  culturalRef  String?
  formalPhrase String?
  exercises    Json

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, mode])
}

model UserProgress {
  id          String       @id @default(uuid())
  userId      String
  conceptId   String
  modeUsed    DeliveryMode
  status      String       @default("not_started")
  score       Int?
  xpEarned    Int          @default(0)
  completedAt DateTime?
  subLessonId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

model ConceptMastery {
  id             String   @id @default(uuid())
  userId         String
  conceptId      String
  correctCount   Int      @default(0)
  incorrectCount Int      @default(0)
  lastSeenAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

   @@unique([userId, conceptId])
}

model Vocabulary {
  id          String  @id @default(uuid())
  word        String
  translation String
  audioUrl    String?
  courseId    String
  difficulty  Int     @default(1)

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress UserVocabProgress[]
}

model UserVocabProgress {
  id           String   @id @default(uuid())
  userId       String
  vocabId      String
  easeFactor   Float    @default(2.5)
  interval     Int      @default(1)
  repetitions  Int      @default(0)
  nextReviewAt DateTime

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
}

model StreakLog {
  id          String   @id @default(uuid())
  userId      String
  date        String   // Format: "YYYY-MM-DD"
  xpEarned    Int      @default(0)
  lessonsDone Int      @default(0)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model SubLesson {
  id         String   @id @default(cuid())
  conceptId  String
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  title      String
  icon       String   @default("sparkles")
  xpReward   Int      @default(10)
  teach      Json     @default("[]")   // TeachBlock[]
  exercises  Json     @default("[]")   // ExerciseV2[]
  realLife   Json?                      // { prompt, chatSeed }
  createdAt  DateTime @default(now())

  @@unique([conceptId, orderIndex])
}
