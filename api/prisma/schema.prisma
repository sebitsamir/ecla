generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Motivation {
  TRAVEL
  HERITAGE
  CAREER
  FUN
}

enum DeliveryMode {
  STORY
  DRILL
  IMMERSION
  PROFESSIONAL
}

enum ExperienceType {
  STORY
  DRILL
  IMMERSION
  PROFESSIONAL
  MISSION
}

enum MasteryLevel {
  NOT_STARTED
  EXPOSED
  DEVELOPING
  CONTROLLED
  TRANSFERRED
  RETAINED
}

model User {
  id                  String       @id @default(uuid())
  clerkId             String       @unique
  email               String       @unique
  motivation          Motivation?
  preferredMode       DeliveryMode @default(DRILL)
  dailyGoalXp         Int          @default(50)
  xpTotal             Int          @default(0)
  unlockedCosmetics   String[]     @default(["gold"])
  equippedCosmetic    String       @default("gold")
  streakDays          Int          @default(0)
  lastActiveAt        DateTime?
  isPro               Boolean      @default(false)
  onboardingCompleted Boolean      @default(false)
  currentLevel        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  experienceProgress UserExperienceProgress[]
  competencyMastery  CompetencyMastery[]
  vocabProgress      UserVocabProgress[]
  streakLogs         StreakLog[]
  missionAttempts    MissionAttempt[]
}

model Language {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nativeName String
  ttsLocale  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courses      Course[]
  vocabulary   Vocabulary[]
  realizations LanguageRealization[]
}

model Course {
  id          String   @id @default(cuid())
  languageId  String
  cefrLevel   String
  title       String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  units    Unit[]

  @@unique([languageId, cefrLevel])
}

model Unit {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@unique([courseId, orderIndex])
}

model Competency {
  id         String   @id @default(cuid())
  code       String   @unique
  unitId     String
  title      String
  canDo      String
  domain     String
  level      String
  orderIndex Int
  difficulty Int      @default(1)
  isCore     Boolean  @default(true)
  xpReward   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit                        Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  prerequisitesAsCompetency   CompetencyPrerequisite[] @relation("CompetencyPrerequisites")
  prerequisitesAsPrerequisite CompetencyPrerequisite[] @relation("PrerequisiteCompetency")
  realizations                LanguageRealization[]
  vocabulary                  CompetencyVocabulary[]
  experiences                 LearningExperience[]
  missions                    Mission[]
  mastery                     CompetencyMastery[]

  @@index([unitId, orderIndex])
}

model CompetencyPrerequisite {
  competencyId   String
  prerequisiteId String

  competency   Competency @relation("CompetencyPrerequisites", fields: [competencyId], references: [id], onDelete: Cascade)
  prerequisite Competency @relation("PrerequisiteCompetency", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([competencyId, prerequisiteId])
  @@index([prerequisiteId])
}

model LanguageRealization {
  id                String  @id @default(cuid())
  competencyId      String
  languageId        String
  functionNote      String?
  grammarNote       String?
  pronunciationNote String?
  culturalNote      String?
  patterns          Json    @default("[]")
  examples          Json    @default("[]")

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([competencyId, languageId])
  @@index([languageId])
}

model Vocabulary {
  id          String   @id @default(cuid())
  languageId  String
  word        String
  translation String
  audioUrl    String?
  difficulty  Int      @default(1)
  createdAt   DateTime @default(now())

  language     Language               @relation(fields: [languageId], references: [id], onDelete: Cascade)
  competencies CompetencyVocabulary[]
  progress     UserVocabProgress[]

  @@index([languageId, word])
}

model CompetencyVocabulary {
  competencyId String
  vocabularyId String
  importance   Int    @default(1)

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([competencyId, vocabularyId])
  @@index([vocabularyId])
}

model LearningExperience {
  id               String         @id @default(cuid())
  competencyId     String
  type             ExperienceType
  title            String
  description      String?
  orderIndex       Int            @default(0)
  content          Json           @default("{}")
  assessment       Json?
  estimatedMinutes Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  competency Competency               @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  progress   UserExperienceProgress[]

  @@index([competencyId, type])
  @@index([competencyId, orderIndex])
}

model UserExperienceProgress {
  id            String    @id @default(cuid())
  userId        String
  experienceId  String
  status        String    @default("not_started")
  score         Int?
  attempts      Int       @default(0)
  xpEarned      Int       @default(0)
  completedAt   DateTime?
  lastAttemptAt DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([userId, experienceId])
  @@index([userId, status])
}

model Mission {
  id              String   @id @default(cuid())
  competencyId    String
  title           String
  objective       String
  scenario        String
  difficulty      Int      @default(1)
  successCriteria Json
  configuration   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competency Competency       @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  attempts   MissionAttempt[]

  @@index([competencyId])
}

model MissionAttempt {
  id          String    @id @default(cuid())
  missionId   String
  userId      String
  score       Int?
  passed      Boolean   @default(false)
  evidence    Json?
  feedback    Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, missionId])
  @@index([missionId])
}

model CompetencyMastery {
  id             String       @id @default(cuid())
  userId         String
  competencyId   String
  level          MasteryLevel @default(NOT_STARTED)
  
  exposureCount  Int          @default(0)
  successCount   Int          @default(0)
  failureCount   Int          @default(0)
  transferCount  Int          @default(0)
  
  comprehensionScore Float?   
  retrievalScore     Float?  
  interactionScore   Float?   
  applicationScore   Float?  
  transferScore      Float?  
  overallScore       Float?  
  
  retentionScore Float?
  lastAssessedAt DateTime?
  nextReviewAt   DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([userId, competencyId])
  @@index([userId, level])
  @@index([userId, competencyId])
}

model UserVocabProgress {
  id           String   @id @default(cuid())
  userId       String
  vocabId      String
  easeFactor   Float    @default(2.5)
  interval     Int      @default(1)
  repetitions  Int      @default(0)
  nextReviewAt DateTime

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
  @@index([userId, nextReviewAt])
}

model StreakLog {
  id          String @id @default(cuid())
  userId      String
  date        String
  xpEarned    Int    @default(0)
  lessonsDone Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
