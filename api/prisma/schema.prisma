generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Motivation {
  TRAVEL
  HERITAGE
  CAREER
  FUN
}

enum DeliveryMode {
  STORY
  DRILL
  IMMERSION
  PROFESSIONAL
}

enum ExperienceType {
  STORY
  DRILL
  IMMERSION
  PROFESSIONAL
  MISSION
}

enum MasteryLevel {
  NOT_STARTED
  EXPOSED
  DEVELOPING
  CONTROLLED
  TRANSFERRED
  RETAINED
}

model User {
  id                  String       @id @default(uuid())
  clerkId             String       @unique
  email               String       @unique
  motivation          Motivation?
  preferredMode       DeliveryMode @default(DRILL)
  dailyGoalXp         Int          @default(50)
  xpTotal             Int          @default(0)
  unlockedCosmetics   String[]     @default(["gold"])
  equippedCosmetic    String       @default("gold")
  streakDays          Int          @default(0)
  lastActiveAt        DateTime?
  displayName         String? 
  isPro               Boolean      @default(false)
  onboardingCompleted Boolean      @default(false)
  currentLevel        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  experienceProgress UserExperienceProgress[]
  competencyMastery  CompetencyMastery[]
  vocabProgress      UserVocabProgress[]
  streakLogs         StreakLog[]
  missionAttempts    MissionAttempt[]
  learningAttempts   LearningAttempt[]
  sceneVisits SceneVisit[]
  assessmentSessions AssessmentSession[]
  learnerPlanSnapshots LearnerPlanSnapshot[]
  pilotParticipations PilotParticipant[]
}

model PilotStudy {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  protocolVersion  String
  consentVersion   String
  consentTextHash  String
  status           String   @default("draft")
  targetMin        Int      @default(20)
  targetMax        Int      @default(30)
  durationWeeks    Int
  createdBy        String
  createdAt        DateTime @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  participants     PilotParticipant[]
  revisions        PilotRevision[]
}

model PilotParticipant {
  id                    String   @id @default(uuid())
  studyId               String
  userId                String
  participantCode       String
  status                String   @default("invited")
  beginnerVerifiedBy    String
  beginnerVerifiedAt    DateTime @default(now())
  eligibilityInstrument String
  consentVersion        String?
  consentedAt           DateTime?
  withdrawnAt           DateTime?
  withdrawalReason      String?
  enrolledAt            DateTime @default(now())
  study                 PilotStudy @relation(fields: [studyId], references: [id], onDelete: Restrict)
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurements          PilotMeasurement[]
  interviews            PilotInterview[]
  predictions           PilotPrediction[]

  @@unique([studyId, userId])
  @@unique([studyId, participantCode])
  @@index([studyId, status])
}

model PilotPrediction {
  id                 String   @id @default(uuid())
  participantId      String
  competencyCode     String?
  situationId        String
  modelVersion       String
  predictedMastery   Float
  evidenceCutoffAt   DateTime
  lockedBy           String
  lockedAt           DateTime @default(now())
  participant        PilotParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  measurement        PilotMeasurement?

  @@unique([participantId, situationId, modelVersion])
  @@index([participantId, lockedAt])
}

model PilotMeasurement {
  id                 String   @id @default(uuid())
  participantId      String
  kind               String
  week               Int?
  competencyCode     String?
  situationId        String?
  instrumentVersion  String
  predictedMastery   Float?
  predictionId       String?  @unique
  observedPerformance Float
  assessorId         String
  assessorIndependent Boolean @default(false)
  evidenceReference  String
  requestKey         String
  notes              String?
  observedAt         DateTime
  createdAt          DateTime @default(now())
  participant        PilotParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  prediction          PilotPrediction? @relation(fields: [predictionId], references: [id], onDelete: Restrict)

  @@unique([participantId, requestKey])
  @@index([participantId, kind, observedAt])
  @@index([competencyCode, kind])
}

model PilotInterview {
  id             String   @id @default(uuid())
  participantId  String
  week           Int
  interviewerId  String
  instrumentVersion String
  codedThemes    Json
  summary        String
  requestKey     String
  conductedAt    DateTime
  createdAt      DateTime @default(now())
  participant    PilotParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, week])
  @@unique([participantId, requestKey])
}

model PilotRevision {
  id              String   @id @default(uuid())
  studyId         String
  actor            String
  decision         String
  rationale        String
  affectedVersions Json
  createdAt        DateTime @default(now())
  study            PilotStudy @relation(fields: [studyId], references: [id], onDelete: Restrict)

  @@index([studyId, createdAt])
}

model LearnerPlanSnapshot {
  id              String   @id @default(uuid())
  userId          String
  version         String
  evidenceVersion String
  plan            Json
  generatedAt     DateTime @default(now())
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@unique([userId, evidenceVersion])
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model PortfolioReviewDecision {
  id                    String   @id @default(uuid())
  competencyId          String
  competencyCode        String
  contentVersion        String
  kind                  String
  decision              String
  reviewerId            String
  reviewerQualification String
  note                  String
  requestKey            String
  createdAt             DateTime @default(now())

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, requestKey])
  @@index([competencyCode, contentVersion, kind, createdAt])
}

model CharacterMemory {
  id           String   @id @default(cuid())
  userId       String
  characterId  String
  encounters   Int      @default(1)
  firstMetAt   DateTime @default(now())
  lastMetAt    DateTime @default(now())
  personality  String?
  occupation   String?
  location     String?
  relationship String?  @default("stranger")
  memories     Json?

  @@unique([userId, characterId])
}

model LearnerEvent {
  id           String   @id @default(cuid())
  userId       String
  competencyId String?
  type         String
  payload      Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([userId, type])
  @@index([userId, competencyId])
}

model Language {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nativeName String
  ttsLocale  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courses      Course[]
  vocabulary   Vocabulary[]
  realizations LanguageRealization[]
}

model Course {
  id          String   @id @default(cuid())
  languageId  String
  cefrLevel   String
  title       String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  units    Unit[]

  @@unique([languageId, cefrLevel])
}

model Unit {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@unique([courseId, orderIndex])
}

model Competency {
  id         String   @id @default(cuid())
  code       String   @unique
  unitId     String
  title      String
  canDo      String
  domain     String
  level      String
  orderIndex Int
  difficulty Int      @default(1)
  isCore     Boolean  @default(true)
  xpReward   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit                        Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  prerequisitesAsCompetency   CompetencyPrerequisite[] @relation("CompetencyPrerequisites")
  prerequisitesAsPrerequisite CompetencyPrerequisite[] @relation("PrerequisiteCompetency")
  realizations                LanguageRealization[]
  vocabulary                  CompetencyVocabulary[]
  experiences                 LearningExperience[]
  missions                    Mission[]
  mastery                     CompetencyMastery[]
  scenes                      Scene[]
  learningAttempts            LearningAttempt[]
  assessmentSessions AssessmentSession[]
  portfolioReviewDecisions PortfolioReviewDecision[]

  @@index([unitId, orderIndex])
}

model CompetencyPrerequisite {
  competencyId   String
  prerequisiteId String

  competency   Competency @relation("CompetencyPrerequisites", fields: [competencyId], references: [id], onDelete: Cascade)
  prerequisite Competency @relation("PrerequisiteCompetency", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([competencyId, prerequisiteId])
  @@index([prerequisiteId])
}

model LanguageRealization {
  id                String  @id @default(cuid())
  competencyId      String
  languageId        String
  functionNote      String?
  grammarNote       String?
  pronunciationNote String?
  culturalNote      String?
  patterns          Json    @default("[]")
  examples          Json    @default("[]")

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([competencyId, languageId])
  @@index([languageId])
}

model Vocabulary {
  id          String   @id @default(cuid())
  languageId  String
  word        String
  translation String
  audioUrl    String?
  difficulty  Int      @default(1)
  createdAt   DateTime @default(now())

  language     Language               @relation(fields: [languageId], references: [id], onDelete: Cascade)
  competencies CompetencyVocabulary[]
  progress     UserVocabProgress[]

  @@index([languageId, word])
}

model CompetencyVocabulary {
  competencyId String
  vocabularyId String
  importance   Int    @default(1)

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([competencyId, vocabularyId])
  @@index([vocabularyId])
}

model LearningExperience {
  id               String         @id @default(cuid())
  competencyId     String
  type             ExperienceType
  title            String
  description      String?
  orderIndex       Int            @default(0)
  content          Json           @default("{}")
  assessment       Json?
  estimatedMinutes Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  competency Competency               @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  progress   UserExperienceProgress[]
  sceneVersions AssessmentSceneVersion[]

  @@index([competencyId, type])
  @@index([competencyId, orderIndex])
}

model UserExperienceProgress {
  id            String    @id @default(cuid())
  userId        String
  experienceId  String
  status        String    @default("not_started")
  score         Int?
  attempts      Int       @default(0)
  xpEarned      Int       @default(0)
  completedAt   DateTime?
  lastAttemptAt DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([userId, experienceId])
  @@index([userId, status])
}

model Mission {
  id              String   @id @default(cuid())
  competencyId    String
  title           String
  objective       String
  scenario        String
  difficulty      Int      @default(1)
  successCriteria Json
  configuration   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competency Competency       @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  attempts   MissionAttempt[]
  assessmentSessions AssessmentSession[]

  @@index([competencyId])
}

model MissionAttempt {
  id          String    @id @default(cuid())
  missionId   String
  userId      String
  score       Int?
  passed      Boolean   @default(false)
  evidence    Json?
  feedback    Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, missionId])
  @@index([missionId])
}

model CompetencyMastery {
  id             String       @id @default(cuid())
  userId         String
  competencyId   String
  level          MasteryLevel @default(NOT_STARTED)
  
  exposureCount  Int          @default(0)
  successCount   Int          @default(0)
  failureCount   Int          @default(0)
  transferCount  Int          @default(0)
  contexts       Json?   
  repairsCompleted Int        @default(0)
  
  comprehensionScore Float?   
  retrievalScore     Float?  
  interactionScore   Float?   
  applicationScore   Float?  
  transferScore      Float?  
  overallScore       Float?  
  
  retentionScore Float?
  confidenceLevel Int?
  performanceJson Json?
  lastAssessedAt DateTime?
  nextReviewAt   DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([userId, competencyId])
  @@index([userId, level])
  @@index([userId, competencyId])
}

model UserVocabProgress {
  id           String   @id @default(cuid())
  userId       String
  vocabId      String
  easeFactor   Float    @default(2.5)
  interval     Int      @default(1)
  repetitions  Int      @default(0)
  nextReviewAt DateTime

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
  @@index([userId, nextReviewAt])
}

model StreakLog {
  id          String @id @default(cuid())
  userId      String
  date        String
  xpEarned    Int    @default(0)
  lessonsDone Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Scene {
  id           String   @id @default(cuid())
  competencyId String
  slug         String   @unique
  archetype    String
  title        String
  environment  String
  timeOfDay    String?
  mood         String?
  objective    String
  mission      String?
  context      Json     @default("{}")
  characters   Json     @default("[]")
  language     Json     @default("{}")
  activities   Json     @default("[]")
  variations   Json     @default("[]")
  transfer     Json?
  assessment   Json?
  mastery      Json?
  metadata     Json?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  versions AssessmentSceneVersion[]
  revisions SceneRevision[]
  publication ScenePublication?

  @@index([competencyId])
}

model AssessmentSceneVersion {
  id String @id @default(cuid())
  sceneId String
  experienceId String
  version String
  definition Json
  published Boolean @default(false)
  educatorReviewed Boolean @default(false)
  createdAt DateTime @default(now())
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  experience LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  attempts LearningAttempt[]
  @@unique([sceneId, version])
}

model LearningAttempt {
  id String @id @default(uuid())
  userId String
  competencyId String
  sceneVersionId String
  idempotencyKey String
  activeKey String?
  status String @default("active")
  sequence Int @default(0)
  snapshot Json
  supportedSteps Int[] @default([])
  retentionEligible Boolean @default(false)
  contextNovel Boolean @default(false)
  startedAt DateTime @default(now())
  expiresAt DateTime
  completedAt DateTime?
  result Json?
  xpAwarded Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  sceneVersion AssessmentSceneVersion @relation(fields: [sceneVersionId], references: [id], onDelete: Restrict)
  responses AttemptResponse[]
  @@unique([userId, idempotencyKey])
  @@unique([userId, activeKey])
  @@index([userId, competencyId, completedAt])
}

model AttemptResponse {
  id String @id @default(uuid())
  attemptId String
  sequence Int
  responseKey String
  answer String
  correct Boolean
  dimension String?
  supported Boolean
  repair Boolean @default(false)
  evaluatorVersion String
  observedAt DateTime @default(now())
  attempt LearningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([attemptId, sequence])
  @@unique([attemptId, responseKey])
}

model SceneRevision {
  id String @id @default(uuid())
  sceneId String
  version String
  schemaVersion Int
  compilerVersion String
  source Json
  compiled Json
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  publication ScenePublication?
  events SceneRevisionEvent[]
  visits SceneVisit[]
  @@unique([sceneId, version])
}
model ScenePublication {
  sceneId String @id
  revisionId String @unique
  publishedBy String
  publishedAt DateTime @default(now())
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  revision SceneRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
}
model SceneRevisionEvent {
  id String @id @default(uuid())
  revisionId String
  actor String
  action String
  note String
  createdAt DateTime @default(now())
  revision SceneRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  @@index([revisionId, createdAt])
}
model SceneVisit {
  id String @id @default(uuid())
  userId String
  revisionId String
  requestKey String
  experimentKey String?
  variant String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision SceneRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  @@unique([userId, requestKey])
  @@index([revisionId, createdAt])
}

model AssessmentRubric {
  id String @id @default(uuid())
  targetKey String
  version String
  definition Json
  evaluatorVersion String
  status String @default("draft")
  createdBy String
  createdAt DateTime @default(now())
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  sessions AssessmentSession[]
  results AssessmentScenarioResult[]
  audits AssessmentAudit[]
  @@unique([targetKey, version])
  @@index([targetKey, status])
}
model AssessmentSession {
  id String @id @default(uuid())
  userId String
  kind String
  missionId String?
  competencyId String?
  rubricId String?
  idempotencyKey String
  activeKey String?
  status String @default("active")
  scenarioOrder String[] @default([])
  currentScenario Int @default(0)
  eligibilitySnapshot Json
  curriculumVersion String
  startedAt DateTime @default(now())
  expiresAt DateTime
  completedAt DateTime?
  finalDecision Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: Restrict)
  competency Competency? @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  rubric AssessmentRubric? @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  turns AssessmentSessionTurn[]
  results AssessmentScenarioResult[]
  audits AssessmentAudit[]
  acoustics AcousticObservation[]
  @@unique([userId, idempotencyKey])
  @@unique([userId, activeKey])
  @@index([userId, kind, completedAt])
}
model AssessmentSessionTurn {
  id String @id @default(uuid())
  sessionId String
  sequence Int
  scenarioId String
  role String
  text String
  source String
  responseKey String?
  replyToKey String?
  repair Boolean @default(false)
  providerModel String?
  observedAt DateTime @default(now())
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, sequence])
  @@unique([sessionId, responseKey])
  @@unique([sessionId, replyToKey])
  @@index([sessionId, scenarioId, sequence])
}
model AssessmentScenarioResult {
  id String @id @default(uuid())
  sessionId String
  scenarioId String
  rubricId String
  objectiveAchieved Boolean
  meaningCommunicated Boolean
  comprehensionEvidence Float
  repairEvidence Boolean
  independence Float
  intelligibility Float?
  confidence Float
  autoQualifies Boolean
  humanDecision Boolean?
  humanConfidence Float?
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  evidence Json
  evaluatorVersion String
  evaluatedAt DateTime @default(now())
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rubric AssessmentRubric @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  @@unique([sessionId, scenarioId])
}
model AcousticObservation {
  id String @id @default(uuid())
  sessionId String
  scenarioId String
  providerReference String
  providerVersion String
  metrics Json
  confidence Float
  consentAttested Boolean
  status String
  reviewedBy String
  reviewNote String
  observedAt DateTime @default(now())
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, scenarioId])
}
model AssessmentAudit {
  id String @id @default(uuid())
  sessionId String?
  rubricId String?
  actor String
  action String
  payload Json
  createdAt DateTime @default(now())
  session AssessmentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rubric AssessmentRubric? @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
  @@index([rubricId, createdAt])
}
