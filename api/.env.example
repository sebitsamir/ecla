# ECLA API (Render/Railway/Fly)
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=

# Frontend origin for CORS — must match deployed Next.js URL
FRONTEND_URL=https://ecla-learn.vercel.app

# The release start command installs the seed curriculum and exposes its draft
# practice scenes. Use `npm run start:strict` when reviewed publication is required.
ECLA_RELEASE_MODE=true

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# AI providers
GROQ_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=20000
TRANSCRIPTION_TIMEOUT_MS=30000
MAX_AUDIO_DURATION_SECONDS=60
AI_REQUESTS_PER_MINUTE=30
AI_REQUESTS_PER_USER_DAY=200
VOICE_REQUESTS_PER_MINUTE=20
VOICE_REQUESTS_PER_USER_DAY=60
MISSION_REQUESTS_PER_MINUTE=40
MISSION_REQUESTS_PER_USER_DAY=150
# One legacy administrator plus an optional comma-separated reviewer allowlist.
ADMIN_CLERK_ID=
ADMIN_CLERK_IDS=
PORTFOLIO_REVIEWER_CLERK_IDS=
PILOT_ASSESSOR_CLERK_IDS=
